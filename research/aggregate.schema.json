{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hy-text usage aggregate",
  "type": "object",
  "required": ["id", "collected_at", "query", "variants", "total", "domains", "layers", "exclusions", "examples"],
  "properties": {
    "id": {"type": "string", "pattern": "^USAGE-[A-Z0-9-]+$"},
    "collected_at": {"type": "string", "format": "date"},
    "query": {"type": "string"},
    "variants": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "total": {"type": "integer", "minimum": 100},
    "domains": {"type": "array", "minItems": 20, "uniqueItems": true, "items": {"type": "string"}},
    "layers": {"type": "object", "minProperties": 3, "additionalProperties": {"type": "integer", "minimum": 0}},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "examples": {"type": "array", "items": {"type": "string", "maxLength": 240}}
  },
  "additionalProperties": false
}
