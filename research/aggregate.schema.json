{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hy-text usage aggregate",
  "type": "object",
  "required": ["id", "collected_at", "query", "variants", "total", "domains", "layers", "exclusions", "examples"],
  "properties": {
    "id": {"type": "string", "pattern": "^USAGE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
    "collected_at": {"type": "string", "format": "date"},
    "query": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "variants": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"minLength": 1, "pattern": "\\S"},
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "total": {"type": "integer", "minimum": 100},
    "domains": {"type": "array", "minItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "layers": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 5,
      "propertyNames": {"enum": ["commercial", "community", "government", "media", "professional"]},
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "\\S",
        "description": "A canonical short verification example; runtime validation requires at least one Unicode letter or number."
      }
    }
  },
  "additionalProperties": false
}
